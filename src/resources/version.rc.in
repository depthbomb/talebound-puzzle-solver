#include <windows.h>
#define wxUSE_NO_MANIFEST 1
#include <wx/msw/wx.rc>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @TALEBOUND_VERSION_RESOURCE@
 PRODUCTVERSION @TALEBOUND_VERSION_RESOURCE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@TALEBOUND_COMPANY_NAME@\0"
            VALUE "FileDescription", "@TALEBOUND_DESCRIPTION@\0"
            VALUE "FileVersion", "@TALEBOUND_VERSION@\0"
            VALUE "InternalName", "@TALEBOUND_BINARY_NAME@\0"
            VALUE "OriginalFilename", "@TALEBOUND_BINARY_NAME@.exe\0"
            VALUE "ProductName", "@TALEBOUND_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@TALEBOUND_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
